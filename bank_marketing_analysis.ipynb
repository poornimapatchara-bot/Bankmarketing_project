# remove helper column before next steps
df = df.drop(columns=['payment_quartile'])


# ── Create derived features ───────────────────────────────────────────────────
df_eng = df.copy()

# 1. Spending to credit ratio
df_eng['spend_to_credit_ratio'] = df_eng['spending'] / df_eng['credit_limit']

# 2. Advance payment efficiency (advance paid vs total spending)
df_eng['payment_efficiency'] = df_eng['advance_payments'] / df_eng['spending']

# 3. Balance utilisation (balance vs credit limit)
df_eng['balance_utilisation'] = df_eng['current_balance'] / df_eng['credit_limit']

# 4. Min payment ratio (min payment vs spending)
df_eng['min_payment_ratio'] = df_eng['min_payment_amt'] / df_eng['spending']

# 5. Max single spend ratio
df_eng['max_spend_ratio'] = df_eng['max_spent_in_single_shopping'] / df_eng['spending']

print('Original features:', df.shape[1])
print('After engineering:', df_eng.shape[1])
print('New features:', list(df_eng.columns[7:]))
df_eng.head(5)


# ── Correlation of engineered features with target ─────────────────────────────
eng_corr = df_eng.corr()['probability_of_full_payment'].sort_values(key=abs, ascending=False)
print('Correlation with target (probability_of_full_payment):')
print(eng_corr.drop('probability_of_full_payment').to_string())

# Bar chart of correlations
fig, ax = plt.subplots(figsize=(10, 5))
colors = ['steelblue' if v >= 0 else 'crimson' for v in eng_corr.drop('probability_of_full_payment')]
eng_corr.drop('probability_of_full_payment').plot(kind='bar', ax=ax, color=colors, edgecolor='white')
ax.axhline(0, color='black', linewidth=0.8)
ax.set_title('Feature Correlation with probability_of_full_payment', fontsize=12, fontweight='bold')
ax.set_ylabel('Pearson r')
ax.set_xticklabels(ax.get_xticklabels(), rotation=45, ha='right')
plt.tight_layout()
plt.savefig('plots_feature_correlation.png', bbox_inches='tight', dpi=120)
plt.show()


# ── Prepare clustering features ───────────────────────────────────────────────
cluster_features = ['spending', 'advance_payments', 'credit_limit',
                    'current_balance', 'min_payment_amt',
                    'spend_to_credit_ratio', 'payment_efficiency']

X_cluster = df_eng[cluster_features].copy()
scaler_c = StandardScaler()
X_scaled = scaler_c.fit_transform(X_cluster)

# ── Elbow method ──────────────────────────────────────────────────────────────
inertias = []
silhouettes = []
K_range = range(2, 9)

for k in K_range:
    km = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = km.fit_predict(X_scaled)
    inertias.append(km.inertia_)
    silhouettes.append(silhouette_score(X_scaled, labels))

fig, axes = plt.subplots(1, 2, figsize=(13, 5))

axes[0].plot(list(K_range), inertias, 'o-', color='steelblue', linewidth=2)
axes[0].set_xlabel('Number of Clusters (k)')
axes[0].set_ylabel('Inertia (WCSS)')
axes[0].set_title('Elbow Method', fontweight='bold')
axes[0].grid(True, alpha=0.4)

axes[1].plot(list(K_range), silhouettes, 's-', color='crimson', linewidth=2)
axes[1].set_xlabel('Number of Clusters (k)')
axes[1].set_ylabel('Silhouette Score')
axes[1].set_title('Silhouette Score', fontweight='bold')
axes[1].grid(True, alpha=0.4)

best_k = list(K_range)[np.argmax(silhouettes)]
axes[1].axvline(best_k, color='navy', linestyle='--', label=f'Best k={best_k}')
axes[1].legend()

plt.suptitle('Optimal Cluster Selection', fontsize=13, fontweight='bold')
plt.tight_layout()
plt.savefig('plots_elbow.png', bbox_inches='tight', dpi=120)
plt.show()

print(f'\nBest k by silhouette: {best_k}  (score={max(silhouettes):.4f})')


# ── Fit final K-Means model ────────────────────────────────────────────────────
BEST_K = best_k  # use silhouette-optimal k

km_final = KMeans(n_clusters=BEST_K, random_state=42, n_init=10)
df_eng['Cluster'] = km_final.fit_predict(X_scaled)

print(f'Cluster counts (k={BEST_K}):')
print(df_eng['Cluster'].value_counts().sort_index())

# Cluster profiles
profile = df_eng.groupby('Cluster')[cluster_features + ['probability_of_full_payment']].mean().round(3)
print('\nCluster Profiles (mean values):')
profile.style.background_gradient(cmap='Blues', axis=0)


# ── PCA 2D visualisation of clusters ──────────────────────────────────────────
pca = PCA(n_components=2, random_state=42)
X_pca = pca.fit_transform(X_scaled)

pca_df = pd.DataFrame(X_pca, columns=['PC1', 'PC2'])
pca_df['Cluster'] = df_eng['Cluster'].values

palette = sns.color_palette('Set2', BEST_K)

fig, ax = plt.subplots(figsize=(9, 6))
for c in range(BEST_K):
    subset = pca_df[pca_df['Cluster'] == c]
    ax.scatter(subset['PC1'], subset['PC2'], s=40, alpha=0.7,
               label=f'Cluster {c}', color=palette[c])

# Plot centroids in PCA space
centroids_pca = pca.transform(km_final.cluster_centers_)
ax.scatter(centroids_pca[:, 0], centroids_pca[:, 1],
           s=200, c='black', marker='X', zorder=5, label='Centroids')

ax.set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]*100:.1f}% variance)')
ax.set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]*100:.1f}% variance)')
ax.set_title(f'Customer Clusters — PCA Projection (k={BEST_K})', fontsize=12, fontweight='bold')
ax.legend()
plt.tight_layout()
plt.savefig('plots_clusters_pca.png', bbox_inches='tight', dpi=120)
plt.show()

print(f'PCA explained variance: {pca.explained_variance_ratio_.sum()*100:.1f}%')


# ── Cluster radar chart (spider) ──────────────────────────────────────────────
from matplotlib.patches import FancyArrowPatch

radar_features = ['spending', 'advance_payments', 'credit_limit',
                  'current_balance', 'probability_of_full_payment']
N = len(radar_features)

# normalise 0-1 for radar
radar_data = df_eng.groupby('Cluster')[radar_features].mean()
radar_norm = (radar_data - radar_data.min()) / (radar_data.max() - radar_data.min())

angles = [n / float(N) * 2 * np.pi for n in range(N)]
angles += angles[:1]

fig, ax = plt.subplots(figsize=(8, 8), subplot_kw=dict(polar=True))
colors = sns.color_palette('Set2', BEST_K)

for i, row in radar_norm.iterrows():
    values = row.tolist()
    values += values[:1]
    ax.plot(angles, values, linewidth=2, color=colors[i], label=f'Cluster {i}')
    ax.fill(angles, values, alpha=0.15, color=colors[i])

ax.set_xticks(angles[:-1])
ax.set_xticklabels(radar_features, size=10)
ax.set_title('Cluster Profile Radar Chart\n(Normalised)', fontsize=12, fontweight='bold', pad=20)
ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1))
plt.tight_layout()
plt.savefig('plots_radar.png', bbox_inches='tight', dpi=120)
plt.show()


# ── Feature / target split ─────────────────────────────────────────────────────
FEATURES = [
    'spending', 'advance_payments', 'current_balance', 'credit_limit',
    'min_payment_amt', 'max_spent_in_single_shopping',
    'spend_to_credit_ratio', 'payment_efficiency',
    'balance_utilisation', 'min_payment_ratio', 'max_spend_ratio', 'Cluster'
]
TARGET = 'probability_of_full_payment'

X = df_eng[FEATURES]
y = df_eng[TARGET]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

print(f'Training set : {X_train.shape[0]} samples')
print(f'Test set     : {X_test.shape[0]} samples')
print(f'Features used: {FEATURES}')


# ── Train & compare multiple models ──────────────────────────────────────────
models = {
    'Linear Regression':     LinearRegression(),
    'Ridge':                 Ridge(alpha=1.0),
    'Lasso':                 Lasso(alpha=0.001),
    'ElasticNet':            ElasticNet(alpha=0.001, l1_ratio=0.5),
    'Decision Tree':         DecisionTreeRegressor(max_depth=5, random_state=42),
    'Random Forest':         RandomForestRegressor(n_estimators=200, random_state=42),
    'Gradient Boosting':     GradientBoostingRegressor(n_estimators=200, learning_rate=0.05,
                                                        max_depth=4, random_state=42),
    'Extra Trees':           ExtraTreesRegressor(n_estimators=200, random_state=42),
    'KNN':                   KNeighborsRegressor(n_neighbors=7),
    'SVR':                   SVR(kernel='rbf', C=10, epsilon=0.001),
}

results = []

for name, model in models.items():
    pipe = Pipeline([
        ('scaler', StandardScaler()),
        ('model', model)
    ])
    # 5-fold CV R²
    cv_r2 = cross_val_score(pipe, X_train, y_train, cv=5, scoring='r2').mean()
    cv_mae = -cross_val_score(pipe, X_train, y_train, cv=5, scoring='neg_mean_absolute_error').mean()
    
    pipe.fit(X_train, y_train)
    y_pred = pipe.predict(X_test)
    
    test_r2   = r2_score(y_test, y_pred)
    test_mae  = mean_absolute_error(y_test, y_pred)
    test_rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    
    results.append({
        'Model':    name,
        'CV R²':    round(cv_r2, 4),
        'CV MAE':   round(cv_mae, 6),
        'Test R²':  round(test_r2, 4),
        'Test MAE': round(test_mae, 6),
        'Test RMSE':round(test_rmse, 6),
    })

results_df = pd.DataFrame(results).sort_values('Test R²', ascending=False).reset_index(drop=True)
print('\n=== Model Comparison ===')
results_df.style.background_gradient(
    subset=['CV R²', 'Test R²'], cmap='Greens'
).background_gradient(
    subset=['Test MAE', 'Test RMSE'], cmap='Reds_r'
)


# ── Model comparison bar chart ─────────────────────────────────────────────────
fig, axes = plt.subplots(1, 2, figsize=(15, 6))

r2_sorted = results_df.sort_values('Test R²')
colors_r2 = ['#2196F3' if i == len(r2_sorted) - 1 else '#90CAF9'
             for i in range(len(r2_sorted))]

axes[0].barh(r2_sorted['Model'], r2_sorted['Test R²'], color=colors_r2, edgecolor='white')
axes[0].set_xlabel('R² Score (higher = better)')
axes[0].set_title('Model Comparison — R²', fontweight='bold')
axes[0].axvline(0.9, color='red', linestyle='--', linewidth=1, alpha=0.6, label='R²=0.9')
axes[0].legend()
for i, (val, name) in enumerate(zip(r2_sorted['Test R²'], r2_sorted['Model'])):
    axes[0].text(val + 0.001, i, f'{val:.4f}', va='center', fontsize=8)

mae_sorted = results_df.sort_values('Test MAE', ascending=False)
colors_mae = ['#F44336' if i == 0 else '#FFCDD2'
              for i in range(len(mae_sorted))]

axes[1].barh(mae_sorted['Model'], mae_sorted['Test MAE'], color=colors_mae, edgecolor='white')
axes[1].set_xlabel('MAE (lower = better)')
axes[1].set_title('Model Comparison — MAE', fontweight='bold')
for i, val in enumerate(mae_sorted['Test MAE']):
    axes[1].text(val + 0.00001, i, f'{val:.5f}', va='center', fontsize=8)

plt.suptitle('Regression Model Performance Comparison', fontsize=13, fontweight='bold')
plt.tight_layout()
plt.savefig('plots_model_comparison.png', bbox_inches='tight', dpi=120)
plt.show()


# ── Best model — detailed analysis ────────────────────────────────────────────
best_model_name = results_df.iloc[0]['Model']
print(f'Best model: {best_model_name}')
print(results_df.iloc[0].to_string())

# Refit best model pipeline
best_pipe = Pipeline([
    ('scaler', StandardScaler()),
    ('model', models[best_model_name])
])
best_pipe.fit(X_train, y_train)
y_pred_best = best_pipe.predict(X_test)


# ── Actual vs Predicted ────────────────────────────────────────────────────────
fig, axes = plt.subplots(1, 2, figsize=(13, 5))

# Scatter
axes[0].scatter(y_test, y_pred_best, alpha=0.6, color='steelblue', s=40, edgecolors='white')
lims = [min(y_test.min(), y_pred_best.min()), max(y_test.max(), y_pred_best.max())]
axes[0].plot(lims, lims, 'r--', linewidth=2, label='Ideal (y=x)')
axes[0].set_xlabel('Actual Probability')
axes[0].set_ylabel('Predicted Probability')
axes[0].set_title(f'Actual vs Predicted\n{best_model_name}', fontweight='bold')
axes[0].legend()

# Residuals
residuals = y_test.values - y_pred_best
axes[1].hist(residuals, bins=20, color='steelblue', edgecolor='white', alpha=0.85)
axes[1].axvline(0, color='red', linestyle='--', linewidth=2)
axes[1].set_xlabel('Residual (Actual − Predicted)')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Residual Distribution', fontweight='bold')

plt.tight_layout()
plt.savefig('plots_actual_vs_predicted.png', bbox_inches='tight', dpi=120)
plt.show()


# ── Feature importances (tree-based models) ───────────────────────────────────
inner_model = best_pipe.named_steps['model']
if hasattr(inner_model, 'feature_importances_'):
    imp = pd.Series(inner_model.feature_importances_, index=FEATURES).sort_values(ascending=True)
    
    fig, ax = plt.subplots(figsize=(9, 6))
    colors_imp = ['#1565C0' if v == imp.max() else '#90CAF9' for v in imp]
    imp.plot(kind='barh', ax=ax, color=colors_imp, edgecolor='white')
    ax.set_xlabel('Feature Importance')
    ax.set_title(f'Feature Importances — {best_model_name}', fontsize=12, fontweight='bold')
    plt.tight_layout()
    plt.savefig('plots_feature_importance.png', bbox_inches='tight', dpi=120)
    plt.show()
else:
    # Linear models — use coefficients
    if hasattr(inner_model, 'coef_'):
        # StandardScaler is applied, so coef corresponds to scaled features
        coef = pd.Series(np.abs(inner_model.coef_), index=FEATURES).sort_values(ascending=True)
        fig, ax = plt.subplots(figsize=(9, 6))
        coef.plot(kind='barh', ax=ax, color='steelblue', edgecolor='white')
        ax.set_xlabel('|Coefficient|')
        ax.set_title(f'Feature Coefficients — {best_model_name}', fontsize=12, fontweight='bold')
        plt.tight_layout()
        plt.savefig('plots_feature_importance.png', bbox_inches='tight', dpi=120)
        plt.show()


        # ── Grid Search on top performer ──────────────────────────────────────────────
# Tune Gradient Boosting (robust and usually top performer)
gb_pipe = Pipeline([
    ('scaler', StandardScaler()),
    ('model', GradientBoostingRegressor(random_state=42))
])

param_grid = {
    'model__n_estimators':  [100, 200, 300],
    'model__learning_rate': [0.03, 0.05, 0.08],
    'model__max_depth':     [3, 4, 5],
}

grid_search = GridSearchCV(
    gb_pipe, param_grid,
    cv=5, scoring='r2',
    n_jobs=-1, verbose=0
)
grid_search.fit(X_train, y_train)

print(f'Best params : {grid_search.best_params_}')
print(f'Best CV R²  : {grid_search.best_score_:.4f}')

tuned_pred = grid_search.best_estimator_.predict(X_test)
tuned_r2   = r2_score(y_test, tuned_pred)
tuned_mae  = mean_absolute_error(y_test, tuned_pred)
tuned_rmse = np.sqrt(mean_squared_error(y_test, tuned_pred))

print(f'\nTuned GradientBoosting on test set:')
print(f'  R²   = {tuned_r2:.4f}')
